# Backend settings, read from environment variables. All are optional: the values
# below are the defaults the app uses when a variable is not set.
#
# To override one for a local run, put it in front of the command, e.g.
#   DATABASE_URL=sqlite:///./data/other.db uv run uvicorn app.main:app --reload
# Docker Compose sets its own values in docker-compose.yml.

# Where the database lives.
#   Local default:       a SQLite file at backend/data/uttt.db
#   Docker Compose sets: sqlite:////app/data/uttt.db (on the backend-data volume)
#   PostgreSQL format:   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#                        (needs the psycopg driver added first; see DECISIONS.md, D22)
DATABASE_URL=sqlite:///./data/uttt.db
