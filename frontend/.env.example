# Frontend settings. All are optional.
#
# The app itself reads no settings: it calls /api/... on the same address it was
# loaded from. In Docker, nginx forwards /api to the backend.

# Only for `pnpm dev`: where the Vite dev server forwards /api requests.
# Default: http://127.0.0.1:8000 (the backend started with `uv run uvicorn ...`).
# Set it in front of the command, e.g.  API_PROXY_TARGET=http://127.0.0.1:9000 pnpm dev
API_PROXY_TARGET=http://127.0.0.1:8000
